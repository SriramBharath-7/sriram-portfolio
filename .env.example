# Copy to .env.local (never commit real values) and set the same variables in
# Vercel -> Project -> Settings -> Environment Variables.
#
# Leave the Supabase values empty to run on the static content in content/:
# the public desktop works normally and /admin shows setup instructions.

# Supabase -> Project Settings -> API (or "Connect"): Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase -> Project Settings -> API Keys: the publishable key (sb_publishable_...).
# It is designed to be public: Row Level Security only lets admins write.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated emails allowed into /admin. Must match the Supabase Auth
# user(s) you add to public.admin_users. Empty = nobody can sign in.
ADMIN_EMAILS=you@example.com

# Optional: GitHub token (no scopes needed) to raise the API rate limit for
# the live Projects page. Server-side only.
GITHUB_TOKEN=

# Never add a secret key (sb_secret_...) here: every write goes through the
# signed-in admin's session and RLS, so the project does not need one.
